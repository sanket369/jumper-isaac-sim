# Every version this repository was tested with, in one place. Sourced by
# bootstrap.sh, run_teleop.sh and scripts/. Tested on Ubuntu 24.04, an RTX PRO 5000
# Blackwell laptop GPU, NVIDIA driver 580.178.04.

# Isaac Sim, the official standalone build.
ISAAC_SIM_VERSION=5.1.0
ISAAC_SIM_ZIP=isaac-sim-standalone-5.1.0-linux-x86_64.zip
ISAAC_SIM_URL=https://download.isaacsim.omniverse.nvidia.com/$ISAAC_SIM_ZIP
ISAAC_SIM_SHA256=6ab0109278c4868b6d796d5e435a0116874cd50a392edfa7cc3350debfb7a187
ISAAC_SIM_DEFAULT_PATH=$HOME/isaacsim/isaac-sim-standalone-5.1.0-linux-x86_64
# Installed into Isaac Sim's Python: the policies are ONNX.
ONNXRUNTIME_VERSION=1.31.0

# Jumper by KingKong Robotics: the robot, the policies and the controller.
JUMPER_REPO=https://github.com/KingKongRobotics/jumper.git
JUMPER_COMMIT=78966f45de6f2b6de3f7cea017f32a39f8b993e6
JUMPER_TASK=jumper.posture

# Jumper's Python environment, used only to export the training model and run the
# MuJoCo reference, so CPU builds of PyTorch are enough. Other packages are pinned
# by config/jumper-constraints.txt.
JUMPER_PYTHON=python3.12
TORCH_INDEX=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.14.1
TORCHVISION_VERSION=0.29.1
